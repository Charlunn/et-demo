# Environment variables for spark-pricing. Copy to `.env` and edit.
# `.env` is gitignored. NEVER commit real secrets. Secret handling is fail-fast
# (see app/core/config.py): in non-debug mode a default/short SECRET_KEY is rejected.

# ---- App ----
DEBUG=true
APP_NAME=spark-pricing

# ---- Database ----
# Postgres for docker-compose; SQLite acceptable for local/tests.
DATABASE_URL=sqlite+aiosqlite:///./spark.db

# ---- Security ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In DEBUG=false this MUST be set, >=32 chars, and NOT the default below.
SECRET_KEY=dev-only-do-not-use-in-production-please-change-me-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
# Demo test user credentials (dev only): token minted via /token endpoint.
DEMO_USER=trader
DEMO_PASSWORD=trader-secret
DEMO_SCOPES=backtest:run

# ---- CORS ----
# Empty list in prod. CORS allowlist; the wildcard origin is rejected.
CORS_ORIGINS=["http://localhost:8501"]

# ---- Domain / business defaults (no bare numbers in business code) ----
DEFAULT_FORECASTER=persistence
RISK_MARKUP=0.0
RESERVE_REQUIREMENT_MW=20.0
LINE_FLOW_LIMIT_MW=80.0
RETENTION_RAW_DAYS=30

# ---- Frontend ----
# Base URL the Streamlit workbench uses to reach the backend API.
BACKEND_API_URL=http://localhost:8000